[Desktop Entry]
Type=Application
Name=hShare
GenericName=Screenshot uploader
GenericName[fr]=Capture et partage d'écran
Comment=Capture a region and upload it
Comment[fr]=Capturer une zone et l'envoyer
Exec=hshare area
Icon=hshare
Terminal=false
Categories=Graphics;Utility;
Keywords=screenshot;capture;upload;record;imgur;
Actions=full;window;record;

[Desktop Action full]
Name=Capture full screen
Name[fr]=Capturer tout l'écran
Exec=hshare full

[Desktop Action window]
Name=Capture active window
Name[fr]=Capturer la fenêtre active
Exec=hshare window

[Desktop Action record]
Name=Start / stop recording
Name[fr]=Démarrer / arrêter l'enregistrement
Exec=hshare record
